@model Leo.MonetaryCredit.Models.CreateRechargeModel

@{
    Layout = "_ConfigurePlugin";
}

<input id="active-menu-item" type="hidden" value="/Admin/MonetaryCredit/RechargeList"/>

<h1>创建充值订单</h1>

<div class="panel panel-default">
    <div class="panel-body">
        <form asp-controller="MonetaryCredit" asp-action="CreateRecharge" method="post">
            <div class="form-horizontal">
                <div asp-validation-summary="All" class="text-danger"></div>
                <div class="form-body">
                    <div class="form-group">
                        <div class="col-md-3 col-sm-3 text-right">
                            <label class="control-label">客户 ID</label>
                        </div>
                        <div class="col-md-9 col-sm-9">
                            <input asp-for="CustomerId" class="form-control" required/>
                            <span asp-validation-for="CustomerId"></span>
                        </div>
                    </div>
                    <div class="form-group">
                        <div class="col-md-3 col-sm-3 text-right">
                            <label class="control-label">充值金额 (元)</label>
                        </div>
                        <div class="col-md-9 col-sm-9">
                            <input asp-for="Amount" class="form-control" type="number" step="0.01" min="0.01" required/>
                            <span asp-validation-for="Amount"></span>
                        </div>
                    </div>
                    <div class="form-group">
                        <div class="col-md-3 col-sm-3 text-right">
                            <label class="control-label">备注</label>
                        </div>
                        <div class="col-md-9 col-sm-9">
                            <textarea asp-for="Remark" class="form-control" rows="3"></textarea>
                        </div>
                    </div>
                </div>
                <div class="form-actions">
                    <div class="row">
                        <div class="offset-md-3 offset-sm-3 col-md-9 col-sm-9">
                            <button type="submit" class="btn green">创建充值订单</button>
                            <a asp-action="RechargeList" class="btn default">返回列表</a>
                        </div>
                    </div>
                </div>
            </div>
        </form>
    </div>
</div>
