@using Grand.Web.Common.Page
@model Leo.MonetaryCredit.Controllers.RechargeReturnViewModel
@inject IPageHeadBuilder pagebuilder
@{
    Layout = "_TwoColumns";
    pagebuilder.AddTitleParts("充值结果");
}

@section left
{
    @await Component.InvokeAsync("CustomerNavigation", new { selectedTabId = 45 })
}

<div class="page account-page monetary-credit-recharge-return">
    <div class="page-title">
        <h1>充值结果</h1>
    </div>
    <div class="page-body">
        <div class="result-box text-center" style="padding: 40px 20px; max-width: 500px; margin: 0 auto;">

            @if (Model.IsPending)
            {
                @if (!string.IsNullOrEmpty(Model.PaymentUrl))
                {
                    <!-- Mode (a): Redirect user to payment gateway -->
                    <div id="result-redirecting">
                        <div style="font-size: 4em; color: #17a2b8; margin-bottom: 15px;">
                            <i class="fa fa-external-link"></i>
                        </div>
                        <h2 style="color: #17a2b8;">正在跳转支付页面</h2>
                        <p class="text-muted">充值金额：<strong style="color: #e7505a;">¥ @Model.Amount.ToString("F2")</strong></p>
                        <p id="redirect-message" class="text-muted">@Model.Message</p>
                        <p class="text-muted" style="font-size: 0.85em;">页面即将自动跳转，如未跳转请
                            <a href="@Model.PaymentUrl" id="manual-redirect-link">点击此处</a>
                        </p>
                    </div>
                }
                else
                {
                    <!-- Mode (b): User returned from gateway; polling for confirmation -->
                    <div id="result-pending">
                        <div style="font-size: 4em; color: #ffc107; margin-bottom: 15px;">
                            <i class="fa fa-spinner fa-spin"></i>
                        </div>
                        <h2 style="color: #856404;">正在确认支付</h2>
                        <p class="text-muted">充值金额：<strong style="color: #e7505a;">¥ @Model.Amount.ToString("F2")</strong></p>
                        <p id="pending-message" class="text-muted">@Model.Message</p>
                        <p class="text-muted" style="font-size: 0.85em;">支付确认中，请勿关闭此页面...</p>
                    </div>
                    <div id="result-success" style="display:none;">
                        <div style="font-size: 4em; color: #28a745; margin-bottom: 15px;">
                            <i class="fa fa-check-circle"></i>
                        </div>
                        <h2 style="color: #28a745;">充值成功</h2>
                        <p class="text-muted">充值金额：<strong style="color: #e7505a;">¥ @Model.Amount.ToString("F2")</strong></p>
                        <p>您的账户余额已更新！</p>
                    </div>
                    <div id="result-failed" style="display:none;">
                        <div style="font-size: 4em; color: #dc3545; margin-bottom: 15px;">
                            <i class="fa fa-times-circle"></i>
                        </div>
                        <h2 style="color: #dc3545;">充值未完成</h2>
                        <p class="text-muted">充值金额：<strong>¥ @Model.Amount.ToString("F2")</strong></p>
                        <p id="failed-message"></p>
                    </div>
                }
            }
            else if (Model.Success)
            {
                <div style="font-size: 4em; color: #28a745; margin-bottom: 15px;">
                    <i class="fa fa-check-circle"></i>
                </div>
                <h2 style="color: #28a745;">充值成功</h2>
                <p class="text-muted">充值金额：<strong style="color: #e7505a;">¥ @Model.Amount.ToString("F2")</strong></p>
                <p>@Model.Message</p>
            }
            else
            {
                <div style="font-size: 4em; color: #dc3545; margin-bottom: 15px;">
                    <i class="fa fa-times-circle"></i>
                </div>
                <h2 style="color: #dc3545;">充值未完成</h2>
                <p class="text-muted">充值金额：<strong>¥ @Model.Amount.ToString("F2")</strong></p>
                <p>@Model.Message</p>
            }

        </div>

        <div class="actions text-center mt-3">
            <a href="/MonetaryCredit/Account" class="btn btn-primary">返回我的余额</a>
        </div>
    </div>
</div>

@if (Model.IsPending)
{
    <script asp-location="Footer" asp-order="300">
        (function () {
            var orderId = '@Html.Raw(Model.OrderId)';
            var paymentUrl = '@Html.Raw(Model.PaymentUrl ?? "")';

            // -------------------------------------------------------------------
            // Mode (a): We have a gateway URL — redirect the user immediately.
            //           After they pay and return, they'll land back on this page
            //           without a paymentUrl and Mode (b) polling will take over.
            // -------------------------------------------------------------------
            if (paymentUrl) {
                // Short delay so the user can see the "redirecting" message
                setTimeout(function () {
                    window.location.href = paymentUrl;
                }, 1500);
                return; // nothing else to do
            }

            // -------------------------------------------------------------------
            // Mode (b): No gateway URL — poll the server for payment confirmation.
            // -------------------------------------------------------------------
            var pollUrl = '/MonetaryCredit/RechargeStatusCheck/' + encodeURIComponent(orderId);
            var maxAttempts = 30;   // 30 × 3s = 90s max wait
            var interval = 3000;
            var attempt = 0;
            var timer = null;
            var dotCount = 0;

            function showSuccess() {
                document.getElementById('result-pending').style.display = 'none';
                document.getElementById('result-failed').style.display = 'none';
                document.getElementById('result-success').style.display = 'block';
            }

            function showFailed(msg) {
                document.getElementById('result-pending').style.display = 'none';
                document.getElementById('result-success').style.display = 'none';
                var failedEl = document.getElementById('result-failed');
                failedEl.style.display = 'block';
                document.getElementById('failed-message').textContent = msg || '支付未完成，您可以稍后在充值记录中重新发起支付';
            }

            function updateDots() {
                dotCount = (dotCount + 1) % 4;
                var dots = new Array(dotCount + 1).join('.');
                var msgEl = document.getElementById('pending-message');
                if (msgEl) msgEl.textContent = '支付确认中' + dots;
            }

            function poll() {
                attempt++;
                updateDots();

                fetch(pollUrl, { credentials: 'same-origin' })
                    .then(function (res) { return res.json(); })
                    .then(function (data) {
                        if (data.status === 'success') {
                            clearInterval(timer);
                            showSuccess();
                        } else if (data.status === 'failed') {
                            clearInterval(timer);
                            showFailed(data.message);
                        } else if (data.status === 'pending') {
                            if (attempt >= maxAttempts) {
                                clearInterval(timer);
                                showFailed('支付确认超时，请稍后在充值记录中查看结果。');
                            }
                            // else continue polling
                        } else {
                            // notfound / forbidden / unexpected
                            clearInterval(timer);
                            showFailed('查询支付状态失败，请返回充值记录查看。');
                        }
                    })
                    .catch(function () {
                        if (attempt >= maxAttempts) {
                            clearInterval(timer);
                            showFailed('网络异常，请稍后在充值记录中查看结果。');
                        }
                    });
            }

            // Start polling immediately, then every 3 seconds
            poll();
            timer = setInterval(poll, interval);
        })();
    </script>
}
